# Copy to backend/.env and fill in real values. Never commit backend/.env.

# --- Required ---------------------------------------------------------------
# Google Cloud project that owns Firestore, Cloud Storage, Vertex AI, and
# Cloud Run. Gemini is accessed through Vertex AI in this project, so no
# separate Gemini API key is needed -- requests authorize via Application
# Default Credentials and bill to this project.
GOOGLE_CLOUD_PROJECT=relay-university-dev
# Cloud Storage bucket that holds report photos.
RELAY_STORAGE_BUCKET=relay-university-dev-report-photos

# --- Optional (defaults shown) ----------------------------------------------
# Gemini model used for triage, deduplication, and routing. Gemini 3.x models
# are not currently served to this project on Vertex AI; verify access with
# scripts/dev/verify_setup.py before changing this.
RELAY_GEMINI_MODEL=gemini-2.5-flash
# Vertex AI region serving the model.
RELAY_GEMINI_LOCATION=us-central1
# Firestore database id; "(default)" unless a named database was provisioned.
RELAY_FIRESTORE_DATABASE=(default)
# Campus whose configuration document drives routing and SLA policy.
RELAY_CAMPUS_ID=relay-university
# Deployment environment: local | staging | production.
RELAY_ENVIRONMENT=local
# Root logger level: DEBUG | INFO | WARNING | ERROR.
RELAY_LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call the API.
RELAY_ALLOWED_ORIGINS=http://localhost:5173
# Lifetime of signed photo URLs handed to the frontend, in seconds.
RELAY_SIGNED_URL_TTL_SECONDS=3600

# Local development uses Application Default Credentials from
# `gcloud auth application-default login` -- no key file, no API key. On Cloud
# Run, the runtime service account provides them instead; it needs the
# Vertex AI User, Datastore User, and Storage Object Admin roles.
