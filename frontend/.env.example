# Copy to frontend/.env.local and adjust. Vite only exposes VITE_-prefixed vars.

# Base URL of the Relay backend. Defaults to the deployed Cloud Run service, so
# a fresh clone talks to a running backend without any local setup. Point it at
# http://localhost:8080 to develop against a local uvicorn instead.
VITE_API_BASE_URL=https://relay-backend-256118957814.us-east1.run.app
